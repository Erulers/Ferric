module("main", version(1,0,0)) {
    scope("global", lifetime("process")) {
        declare(text, "message",
            value(text, "..- ... .---- .---- --- .... --"),
            mutable(false),
            visibility(private));

        invoke(
            function("stdout.write"),
            arguments(
                reference("message",
                    expected_type(text),
                    access(read_only))
            ),
            effects(io),
            result(discard(void))
        );
    }
}
